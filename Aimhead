--========================================================--
--                    FOV UPDATE                        --
--========================================================--

local function UpdateFOVCircle()

	local diameter =
		CONFIG.FOV * 2

	FOVCircle.Size =
		UDim2.new(
			0,
			diameter,
			0,
			diameter
		)

	FOVCircle.Position =
		UDim2.new(
			0.5,
			0,
			0.5,
			0
		)

	FOVCircle.Visible =
		CONFIG.AIM_ENABLED
end


--========================================================--
--                    AIM LOOP                          --
--========================================================--

local AimConnection

AimConnection =
	RunService.RenderStepped:Connect(
		function(deltaTime)

			if Destroyed then
				return
			end

			UpdateFOVCircle()

			if not CanAim() then

				CurrentTarget = nil

				return
			end

			Accumulator += deltaTime

			if Accumulator <
				CONFIG.UPDATE_RATE then

				return
			end

			Accumulator = 0

			-- Giữ mục tiêu hiện tại
			-- nếu nó vẫn hợp lệ.
			if CurrentTarget then

				if not
					IsCurrentTargetValid() then

					CurrentTarget = nil
				end
			end

			-- Chỉ tìm mục tiêu mới
			-- khi mục tiêu cũ không còn hợp lệ.
			if not CurrentTarget then

				CurrentTarget =
					GetBestTarget()
			end

			if CurrentTarget then

				AimAtTarget(
					CurrentTarget
				)
			end
		end
	)


