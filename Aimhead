	function(player)

		if not CurrentTarget then
			return
		end

		if player.Character
			and CurrentTarget:IsDescendantOf(
				player.Character
			) then

			CurrentTarget = nil
		end
	end
)


--========================================================--
--                  CHARACTER RESET                      --
--========================================================--

LocalPlayer.CharacterRemoving:Connect(
	function()

		CurrentTarget = nil
		IsAiming = false
	end
)


--========================================================--
--                     CLEANUP                           --
--========================================================--

script.Destroying:Connect(
	function()

		Destroyed = true

		if AimConnection then

			AimConnection:Disconnect()

			AimConnection = nil
		end

		CurrentTarget = nil

		if ScreenGui then
			ScreenGui:Destroy()
		end
	end
)


