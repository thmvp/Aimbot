--                         CONFIG                         --
--========================================================--

local CONFIG = {
	AIM_ENABLED = false,

	FOV = 120,
	SMOOTHNESS = 0.15,
	MAX_DISTANCE = 500,

	TARGET_PART = "Head",

	HOLD_TO_AIM = true,
	REQUIRE_LINE_OF_SIGHT = true,

	UPDATE_RATE = 1 / 30,
}


--========================================================--
--                       STATE                           --
--========================================================--

local CurrentTarget = nil
local IsAiming = false
local Accumulator = 0
local Destroyed = false


--========================================================--
--                  CHARACTER CHECK                      --
--========================================================--

local function IsAlive(character)

	if not character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	return humanoid
		and humanoid.Health > 0
end


--========================================================--
--                    TARGET PART                        --
--========================================================--

local function GetTargetPart(character)

	if not character then
		return nil
	end

	return character:FindFirstChild(
		CONFIG.TARGET_PART
	)
end


--========================================================--
--                  DISTANCE CHECK                       --
--========================================================--

local function IsWithinDistance(part)

	if not part then
		return false
	end

	local distance =
		(Camera.CFrame.Position - part.Position).Magnitude

	return distance <= CONFIG.MAX_DISTANCE
end


--========================================================--
--                     FOV CHECK                         --
--========================================================--

local function IsInsideFOV(part)

	if not part then
		return false
	end

	local screenPosition, visible =
		Camera:WorldToViewportPoint(
			part.Position
		)

	if not visible or screenPosition.Z <= 0 then
		return false
	end

	local center =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

	local targetPosition =
		Vector2.new(
			screenPosition.X,
			screenPosition.Y
		)

	return (
		targetPosition - center
	).Magnitude <= CONFIG.FOV
end


--========================================================--
--                  LINE OF SIGHT                        --
--========================================================--

local function HasLineOfSight(part)

	if not CONFIG.REQUIRE_LINE_OF_SIGHT then
		return true
	end

	if not part then
		return false
	end

	local character =
		LocalPlayer.Character

	if not character then
		return false
	end

	local origin =
		Camera.CFrame.Position

	local direction =
		part.Position - origin

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		character
	}

	params.IgnoreWater = true

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(
		part.Parent
	)
end


--========================================================--
--                 VALID TARGET CHECK                    --
--========================================================--

local function IsValidTarget(player)

	if not player then
		return false
	end

	if player == LocalPlayer then
		return false
	end

	local character =
		player.Character

	if not IsAlive(character) then
		return false
	end

	local part =
		GetTargetPart(character)

	if not part then
		return false
	end

	if not IsWithinDistance(part) then
		return false
	end

	if not IsInsideFOV(part) then
		return false
	end

	if not HasLineOfSight(part) then
		return false
	end

	return true
end


--========================================================--
--                  FIND BEST TARGET                     --
--========================================================--

local function GetBestTarget()

	local bestTarget = nil
	local bestScore = math.huge

	local center =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if IsValidTarget(player) then

			local character =
				player.Character

			local part =
				GetTargetPart(character)

			if part then

				local screenPosition =
					Camera:WorldToViewportPoint(
						part.Position
					)

				local screenPoint =
					Vector2.new(
						screenPosition.X,
						screenPosition.Y
					)

				local screenDistance =
					(screenPoint - center).Magnitude

				local worldDistance =
					(Camera.CFrame.Position -
						part.Position).Magnitude

				local score =
					screenDistance +
					worldDistance * 0.001

				if score < bestScore then
					bestScore = score
					bestTarget = part
				end
			end
		end
	end

	return bestTarget
end


--========================================================--
--             CURRENT TARGET VALIDATION                 --
--========================================================--

local function IsCurrentTargetValid()

	if not CurrentTarget then
		return false
	end

	local character =
		CurrentTarget.Parent

	if not character then
		return false
	end

	if not IsAlive(character) then
		return false
	end

	if not IsWithinDistance(
		CurrentTarget
	) then
		return false
	end

	if not IsInsideFOV(
		CurrentTarget
	) then
		return false
	end

	if not HasLineOfSight(
		CurrentTarget
	) then
		return false
	end

	return true
end


--========================================================--
--                       AIM                            --
--========================================================--

local function AimAtTarget(part)

	if not part then
		return
	end

	local desired =
		CFrame.lookAt(
			Camera.CFrame.Position,
			part.Position
		)

	local smooth =
		math.clamp(
			CONFIG.SMOOTHNESS,
			0.01,
			1
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			desired,
			smooth
		)
end


--========================================================--
--                  INPUT SYSTEM                         --
--========================================================--

UserInputService.InputBegan:Connect(
	function(input, processed)

		if processed then
			return
		end

		if input.UserInputType ==
			Enum.UserInputType.MouseButton2 then

			IsAiming = true
		end
	end
)


UserInputService.InputEnded:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton2 then

			IsAiming = false
		end
	end
)


local function CanAim()

	if not CONFIG.AIM_ENABLED then
		return false
	end

	if CONFIG.HOLD_TO_AIM then
		return IsAiming
	end

	return true
end


