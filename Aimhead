--                     SLIDER                           --
--========================================================--

local function CreateSlider(
	name,
	y,
	minValue,
	maxValue,
	defaultValue,
	callback
)

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.new(1, -30, 0, 22)

	label.Position =
		UDim2.new(0, 15, 0, y)

	label.BackgroundTransparency = 1

	label.Text =
		name .. ": " ..
		tostring(defaultValue)

	label.TextColor3 =
		Color3.fromRGB(
			220,
			220,
			220
		)

	label.TextSize = 13

	label.Font =
		Enum.Font.Gotham

	label.TextXAlignment =
		Enum.TextXAlignment.Left

	label.Parent = Main


	local bar =
		Instance.new("TextButton")

	bar.Size =
		UDim2.new(1, -30, 0, 8)

	bar.Position =
		UDim2.new(
			0,
			15,
			0,
			y + 27
		)

	bar.BackgroundColor3 =
		Color3.fromRGB(
			60,
			60,
			68
		)

	bar.BorderSizePixel = 0

	bar.Text = ""

	bar.Parent = Main


	local corner =
		Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(1, 0)

	corner.Parent = bar


	local dragging = false


	local function SetValue(x)

		local alpha =
			math.clamp(
				(
					x -
					bar.AbsolutePosition.X
				) /
				bar.AbsoluteSize.X,
				0,
				1
			)

		local value =
			minValue +
			(
				maxValue -
				minValue
			) * alpha

		value =
			math.floor(
				value * 100
			) / 100

		label.Text =
			name .. ": " ..
			tostring(value)

		callback(value)
	end


	bar.InputBegan:Connect(
		function(input)

			if input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or input.UserInputType ==
				Enum.UserInputType.Touch then

				dragging = true

				SetValue(
					input.Position.X
				)
			end
		end
	)


	UserInputService.InputChanged:Connect(
		function(input)

			if not dragging then
				return
			end

			if input.UserInputType ==
				Enum.UserInputType.MouseMovement
				or input.UserInputType ==
				Enum.UserInputType.Touch then

				SetValue(
					input.Position.X
				)
			end
		end
	)


	UserInputService.InputEnded:Connect(
		function(input)

			if input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or input.UserInputType ==
				Enum.UserInputType.Touch then

				dragging = false
			end
		end
	)
end


